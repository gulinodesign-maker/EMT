<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>Ecojumbo</string>
<key>CFBundleName</key><string>Ecojumbo</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>LSRequiresIPhoneOS</key><true/>
<key>NSLocationWhenInUseUsageDescription</key><string>Ecojumbo usa la posizione per velocità GPS, viaggi, itinerari con MapKit e temperatura meteo esterna: invia coordinate geografiche approssimate a Open-Meteo per recuperare il dato meteorologico.</string>
<key>NSAppleMusicUsageDescription</key><string>Ecojumbo legge titolo, artista e copertina del brano nell'app Musica e controlla riproduzione, pausa e tracce quando scegli Apple Music nel cockpit.</string>
<key>CFBundleURLTypes</key><array><dict>
<key>CFBundleURLName</key><string>it.ecojumbo.battery.spotify-auth</string>
<key>CFBundleURLSchemes</key><array><string>ecojumbo-spotify</string></array>
</dict></array>
<key>LSApplicationQueriesSchemes</key><array><string>spotify</string></array>
<key>NSBluetoothAlwaysUsageDescription</key><string>Ecojumbo usa il Bluetooth per leggere i dati del BMS della batteria dello scooter.</string>
<key>UIApplicationSupportsIndirectInputEvents</key><true/>
<key>UILaunchScreen</key><dict/>
<key>UIRequiresFullScreen</key><true/>
<key>UIStatusBarHidden</key><true/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
</dict></plist>
